# Dockerfile.turboquant-cuda
# TurboQuant llama-server with CUDA — for Windows WSL2 (RTX 4090) and EC2 (A10G)
# Based on upstream .devops/cuda.Dockerfile "server" target, adapted for turbo4 KV cache.
#
# Build:
#   docker build -f Dockerfile.turboquant-cuda -t turboquant-llama-server:latest .
#
# Run:
#   docker run --gpus all -p 11435:11435 -v /models:/models \
#     turboquant-llama-server:latest \
#     -m /models/Qwen3.5-9B-Q4_K_M.gguf \
#     --cache-type-k q8_0 --cache-type-v turbo4 \
#     -c 8192 -ngl 99 --flash-attn on --port 11435 --host 0.0.0.0

ARG UBUNTU_VERSION=24.04
ARG CUDA_VERSION=12.8.1
ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}
ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

# ---------- Build stage ----------
FROM ${BASE_CUDA_DEV_CONTAINER} AS build

# 86 = Ampere (A10G), 89 = Ada Lovelace (RTX 4090)
ARG CUDA_DOCKER_ARCH="86;89"

RUN apt-get update && \
    apt-get install -y gcc-14 g++-14 build-essential cmake python3 python3-pip git libssl-dev libgomp1

ENV CC=gcc-14 CXX=g++-14 CUDAHOSTCXX=g++-14

WORKDIR /app
COPY . .

RUN cmake -B build \
      -DGGML_NATIVE=OFF \
      -DGGML_CUDA=ON \
      -DGGML_BACKEND_DL=ON \
      -DGGML_CPU_ALL_VARIANTS=ON \
      -DLLAMA_BUILD_TESTS=OFF \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_DOCKER_ARCH}" \
      -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
      . && \
    cmake --build build --config Release -j$(nproc)

RUN mkdir -p /app/lib && \
    find build -name "*.so*" -exec cp -P {} /app/lib \;

# ---------- Runtime stage ----------
FROM ${BASE_CUDA_RUN_CONTAINER} AS server

RUN apt-get update \
    && apt-get install -y libgomp1 curl \
    && apt autoremove -y \
    && apt clean -y \
    && rm -rf /tmp/* /var/tmp/* \
    && find /var/cache/apt/archives /var/lib/apt/lists -not -name lock -type f -delete \
    && find /var/cache -type f -delete

COPY --from=build /app/lib/ /app
COPY --from=build /app/build/bin/llama-server /app/llama-server

WORKDIR /app

ENV LLAMA_ARG_HOST=0.0.0.0

EXPOSE 11435

HEALTHCHECK CMD ["curl", "-f", "http://localhost:11435/health"]

ENTRYPOINT ["/app/llama-server"]
